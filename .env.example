# Режим окружения
NODE_ENV=production
PORT=3000

# Токен администратора
LEADS_ADMIN_TOKEN=your-admin-token-here

# MapTiler API ключ (нужен как в рантайме, так и при сборке Next.js)
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key-here

# Подключение к базе данных Neon Postgres
DATABASE_URL=postgresql://user:password@ep-xyz.region.neon.tech/dbname?sslmode=require
POSTGRES_URL=postgresql://user:password@ep-xyz.region.neon.tech/dbname?sslmode=require
